# Copy file này thành .env rồi điền giá trị thật
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent
# Để trống EMBED_BASE_URL và EMBED_API_KEY nếu dùng chung với LLM
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=gemini-embedding-001
# Tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
# Chỉ cần khi nhúng chat vào domain khác, dạng JSON: ["https://tienloi24h.vn"]
CORS_ORIGINS=[]
# Mật khẩu đăng nhập Grafana (user: admin)
GRAFANA_PASSWORD=

# --- Cấu hình khi dùng vLLM tự host (Bài 16) ---
# LLM_BASE_URL=https://<dia-chi-server-vllm>/v1
# LLM_API_KEY=<VLLM_API_KEY>
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# EMBED_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# EMBED_API_KEY=<API key Gemini>
